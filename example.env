TG_MAIN_BOT_TOKEN=XXXXXXXXXX:AAAAA_BBBBBBBBBBBBBBBBBBBBBB
TG_ADMIN_ID=912185600
TG_FFMPEG_THREADS=1
TG_FFMPEG_MAX_JOBS=1

# Local Bot API Server (telegram-bot-api --local), see docker-compose.local-api.yml.
# false (default): talks to the public api.telegram.org Cloud API, video
# size limit is fixed at 49 MB, no extra container required - works anywhere.
# true: routes through the local telegram_bot_api sidecar, limit rises to
# 1950 MB. Requires TELEGRAM_API_ID/TELEGRAM_API_HASH below and starting the
# stack with both compose files (see README).
TG_LOCAL_BOT_API_ENABLED=false
# Get these at https://my.telegram.org/apps. Only needed when
# TG_LOCAL_BOT_API_ENABLED=true.
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX