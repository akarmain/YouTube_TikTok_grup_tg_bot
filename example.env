TG_MAIN_BOT_TOKEN=XXXXXXXXXX:AAAAA_BBBBBBBBBBBBBBBBBBBBBB
TG_ADMIN_ID=912185600
TG_FFMPEG_THREADS=1
TG_FFMPEG_MAX_JOBS=1

# 1950 assumes the Local Bot API Server below is running (2000 MB send limit).
# Talking to api.telegram.org directly instead? Set this back to 49 or lower.
TG_MAX_VIDEO_SIZE_MB=1950

# Local Bot API Server (telegram-bot-api --local), see docker-compose.yml.
# Get these at https://my.telegram.org/apps. Leave TG_LOCAL_BOT_API_BASE_URL
# unset to fall back to the public api.telegram.org Cloud API.
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TG_LOCAL_BOT_API_BASE_URL=http://telegram-bot-api:8081
