TG_MAIN_BOT_TOKEN=XXXXXXXXXX:AAAAA_BBBBBBBBBBBBBBBBBBBBBB
TG_ADMIN_ID=912185600
# TG_FFMPEG_THREADS / TG_FFMPEG_MAX_JOBS: leave unset to auto-size from CPU
# core count (max_jobs = cores // 2, threads = cores // max_jobs). Set either
# one explicitly to override the auto-calculated value.
# TG_FFMPEG_THREADS=2
# TG_FFMPEG_MAX_JOBS=2
# TG_DOWNLOAD_WORKERS: size of the download->compress->send worker pool.
# Defaults to TG_FFMPEG_MAX_JOBS when unset.
# TG_DOWNLOAD_WORKERS=2

# Fast YouTube mode: cap quality and prefer Telegram-compatible H.264/AAC
# streams to avoid downloading and transcoding multi-hundred-MB 4K files.
# Set to false to restore the legacy "best quality >=420p" behaviour.
YOUTUBE_FAST_DOWNLOAD_ENABLED=true
YOUTUBE_MIN_HEIGHT=420
YOUTUBE_MAX_HEIGHT=720
YOUTUBE_TARGET_SIZE_MB=80
# Parallel DASH/HLS fragments used by yt-dlp while fast mode is enabled.
YOUTUBE_CONCURRENT_FRAGMENTS=4

# Local Bot API Server (telegram-bot-api --local), see docker-compose.local-api.yml.
# false (default): talks to the public api.telegram.org Cloud API, video
# size limit is fixed at 49 MB, no extra container required - works anywhere.
# true: routes through the local telegram_bot_api sidecar, limit rises to
# 1950 MB. Requires TELEGRAM_API_ID/TELEGRAM_API_HASH below and starting the
# stack with both compose files (see README).
TG_LOCAL_BOT_API_ENABLED=false
# Get these at https://my.telegram.org/apps. Only needed when
# TG_LOCAL_BOT_API_ENABLED=true.
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
